{
  "manifest_version": 3,
  "name": "APIChat",
  "version": "0.1.0",
  "description": "Chat with Claude through your own API key, in Chrome's side panel. Reads and acts on your tabs; uses TokenSaver when APIChat runs on the PC.",
  "minimum_chrome_version": "116",
  "action": { "default_title": "APIChat", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" } },
  "side_panel": { "default_path": "src/panel.html" },
  "background": { "service_worker": "src/background.js" },
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "tabs", "scripting", "clipboardRead", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
